class Solution:
    def minMoves(self, nums, limit):
        diff = [0] * (2 * limit + 2)
        n = len(nums)

        for i in range(n // 2):
            a, b = sorted([nums[i], nums[n - 1 - i]])

            diff[2] += 2
            diff[a + 1] -= 1
            diff[a + b] -= 1
            diff[a + b + 1] += 1
            diff[b + limit + 1] += 1

        ans = n
        moves = 0

        for s in range(2, 2 * limit + 1):
            moves += diff[s]
            ans = min(ans, moves)

        return ans
